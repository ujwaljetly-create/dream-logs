rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;

      match /personas/{personaId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /dreamPhotos/{photoId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /castInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string;
      allow read: if signedIn()
        && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
    }

    match /dreams/{dreamId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.type in ['story', 'movie']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 10000
        && request.resource.data.castIds is list
        && request.resource.data.castIds.size() <= 30;
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.status == 'completed' && (
          resource.data.get('visibility', 'private') == 'public' ||
          (resource.data.get('visibility', 'private') == 'friends' &&
           request.auth.uid in resource.data.get('sharedWith', []))
        ))
      );
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description', 'visibility', 'sharedWith'])
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 10000
        && request.resource.data.get('visibility', 'private') in ['private', 'friends', 'public']
        && request.resource.data.get('sharedWith', []) is list
        && request.resource.data.get('sharedWith', []).size() <= 100;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
